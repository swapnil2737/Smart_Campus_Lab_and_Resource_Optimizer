{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Flask Backend",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app.py",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FLASK_DEBUG": "0"
            },
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

